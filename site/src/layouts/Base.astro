---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** JSON-LD for the page. Defaults to the app itself. */
  structured?: object;
}

const { title, description, structured } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Tjuvkik",
  description,
  url: Astro.site?.href,
  image: ogImage.href,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 15 or later",
  license: "https://opensource.org/licenses/MIT",
  codeRepository: "https://github.com/banjo/tjuvkik",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Anton Ödman", url: "https://banjoanton.com" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0e0b1a" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-64.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tjuvkik" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Tjuvkik glance: a board of panels over a macOS desktop" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(structured ?? app)} />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
