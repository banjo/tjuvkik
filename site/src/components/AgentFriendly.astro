---
import { deploys } from "../data/panels";
import CodeBlock from "./CodeBlock.astro";
import Tile from "./Tile.astro";

const session = `
$ tjuvkik new deploys --type timeline
created ~/.config/tjuvkik/panels/deploys/panel.jsonc
created ~/.config/tjuvkik/panels/deploys/deploys.sh

$ tjuvkik run deploys
deploys: timeline, ran in 0.84s
  shows timeline, 4 events

$ tjuvkik preview deploys --size m
deploys-m.png: m, 535×185 pt at 2x, deploys

$ tjuvkik validate
✓ config.jsonc and 7 panels are valid, 6 on the board`;

const prompt =
  "Make a Tjuvkik panel that shows this week's deploys from `gh run list` as a timeline. Start with `tjuvkik new deploys --type timeline`, check the output with `tjuvkik run deploys`, look at `tjuvkik preview deploys` and fix it until it reads well, then run `tjuvkik validate`. The docs are at https://tjuvkik.banjoanton.com/llms.txt.";
---

<section class="section" aria-labelledby="build-title">
  <div class="container">
    <p class="eyebrow">Agent-friendly</p>
    <h2 class="section-title" id="build-title">Ask your agent for a panel. It can check its own work.</h2>
    <p class="section-lead">
      Every file has a JSON Schema, and the command line closes the loop: make a panel, run it, render its tile to a
      PNG, validate the folder. A coding agent can write a panel, look at the picture and fix it, without you opening
      anything.
    </p>

    <div class="split">
      <CodeBlock file="Terminal" lang="shellsession" code={session} />
      <div class="preview">
        <div class="preview-file">deploys-m.png</div>
        <div class="wallpaper preview-canvas">
          <Tile panel={deploys} class="preview-tile" />
        </div>
      </div>
    </div>

    <div class="prompt">
      <div class="prompt-head">
        <span>A prompt to start from</span>
        <button type="button" class="copy" data-copy={prompt}>Copy</button>
      </div>
      <p>{prompt}</p>
    </div>

    <ul class="links">
      <li><a href="/llms.txt"><code>/llms.txt</code></a> what Tjuvkik is, for a model</li>
      <li><a href="/llms-full.txt"><code>/llms-full.txt</code></a> every doc, as one Markdown file</li>
      <li><a href="/docs/config.md"><code>/docs/*.md</code></a> any docs page, as Markdown</li>
      <li>
        <a href="/schema/panel.schema.json"><code>/schema/*.schema.json</code></a> config, panel and theme schemas, for{" "}
        <code>$schema</code>
      </li>
    </ul>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 20px;
    margin-top: 56px;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  .preview {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 16px;
    overflow: hidden;
    background: #1f2029;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
  }

  .preview-file {
    padding: 11px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font: 500 12.5px/1 var(--mono);
    color: var(--text-faint);
  }

  .preview-canvas {
    display: grid;
    place-items: center;
    padding: clamp(18px, 3vw, 36px);
    border-radius: 0;
    box-shadow: none;
  }

  .preview-canvas :global(.preview-tile) {
    width: 100%;
    max-width: 535px;
    height: 200px;
  }

  .prompt {
    margin-top: 20px;
    padding: 18px 20px 20px;
    border-radius: 16px;
    background: linear-gradient(180deg, rgba(189, 147, 249, 0.1), rgba(189, 147, 249, 0.04));
    box-shadow: 0 0 0 1px rgba(189, 147, 249, 0.22) inset;
  }

  .prompt-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }

  .prompt p {
    margin: 10px 0 0;
    font: 14px/1.65 var(--mono);
    color: var(--text);
  }

  .copy {
    padding: 6px 13px;
    border: 0;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--text);
    font: 600 12.5px var(--sans);
    cursor: pointer;
    transition:
      background-color 150ms ease-out,
      transform 120ms var(--ease-out);
  }

  .copy:active {
    transform: scale(0.96);
  }

  @media (hover: hover) {
    .copy:hover {
      background: rgba(255, 255, 255, 0.16);
    }
  }

  .links {
    list-style: none;
    margin: 28px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    font-size: 14.5px;
    color: var(--text-faint);
  }

  .links a {
    text-decoration: none;
    margin-right: 6px;
  }

  .links code {
    font-size: 13px;
    color: var(--accent);
  }

  .links li > code {
    color: var(--text-muted);
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 1600);
    });
  }
</script>
