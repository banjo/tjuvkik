---
import { site } from "../data/site";
import CopyButton from "./CopyButton.astro";
import Footer from "./Footer.astro";
import GitHubIcon from "./GitHubIcon.astro";

const badges = [
  "Native Swift",
  "No dependencies",
  "No Dock icon",
  "Never takes focus",
  "Pauses when locked or on Low Power",
  "Light and dark glass, Dracula, your own themes",
  "Launch at login",
];
---

<section class="section native" aria-labelledby="native-title">
  <div class="container">
    <h2 class="visually-hidden" id="native-title">Native and light</h2>
    <ul class="badges">
      {badges.map((b) => <li>{b}</li>)}
    </ul>
  </div>
</section>

<section class="section cta" aria-labelledby="cta-title">
  <div class="container cta-inner">
    <img src="/icon.svg" alt="" width="112" height="112" />
    <h2 class="section-title" id="cta-title">Take a peek.</h2>
    <p class="section-lead">Free and open source, for macOS 15 or later on Apple silicon.</p>
    <div class="brew">
      <code><span aria-hidden="true">$</span> {site.brew}</code>
      <CopyButton text={site.brew} />
    </div>
    <div class="buttons">
      <a class="button button-primary" href={site.repo}><GitHubIcon />View on GitHub</a>
      <a class="button button-ghost" href="/docs/">Read the docs</a>
    </div>
  </div>
</section>

<Footer />

<style>
  .native {
    padding-block: 0 24px;
  }

  .badges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .badges li {
    padding: 8px 15px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.045);
    box-shadow: 0 0 0 1px var(--border) inset;
    font-size: 14px;
    color: var(--text-muted);
  }

  .cta {
    position: relative;
    isolation: isolate;
  }

  .cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(500px 300px at 35% 60%, rgba(107, 63, 160, 0.35), transparent 70%),
      radial-gradient(500px 300px at 65% 40%, rgba(180, 70, 107, 0.25), transparent 70%);
  }

  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .cta-inner img {
    margin-bottom: 8px;
  }

  .cta-inner .section-title {
    max-width: none;
  }

  .brew {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 100%;
    margin-top: 32px;
    padding: 10px 10px 10px 20px;
    border-radius: 99px;
    background: rgba(22, 18, 42, 0.72);
    box-shadow: 0 0 0 1px rgba(189, 147, 249, 0.22) inset;
  }

  .brew code {
    min-width: 0;
    font-size: 14px;
    white-space: nowrap;
    overflow-x: auto;
  }

  .brew code span {
    color: var(--accent);
    user-select: none;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

</style>
