---
import { prActions } from "../data/panels";
import { site } from "../data/site";
import CodeBlock from "./CodeBlock.astro";
import Tile from "./Tile.astro";

const panelJson = `
{
  "$schema": "${site.schema("panel")}",
  "type": "script",
  "title": "Pull requests",
  "command": "./prs.sh",
  "every": "5m",
  "requires": ["gh", "jq"],
  "size": "m"
}`;

const script = `
#!/bin/sh
gh search prs --review-requested=@me --state=open \\
  --json number,title,repository,url |
jq '{
  hero: { value: "\\(length)", label: "reviews requested" },
  rows: map({
    icon: "👀", title, url,
    subtitle: "\\(.repository.nameWithOwner) #\\(.number)",
    actions: [
      { title: "Approve", key: "a",
        command: "gh pr review \\(.url) --approve" },
      { title: "Check Out", command: "gh pr checkout \\(.url)" },
      { title: "Copy Link", copy: .url }
    ]
  })
}'`;

const oneLiner = `ls -t ~/Downloads | head -20 | jq -R '{ title: . }' | jq -s '{ rows: . }'`;

const points = [
  {
    title: "Any language",
    text: "Shell, Python, Node, Go, a curl. If it prints JSON to stdout, it's a panel. If it doesn't, a cli panel shows its output as is.",
  },
  {
    title: "Interval or stream",
    text: "Run every 30 seconds, or keep the command running and update the tile on every line, like tail -f.",
  },
  {
    title: "Act on what you see",
    text: "Click a row to open its link or run its command. ⌘K lists its actions, ⌘ and a key runs one. Approve, check out, jump, copy.",
  },
  {
    title: "One panel, many tiles",
    text: "Panels take options, so the same CI panel watches five repos. Each tile sets its own; the script reads them from the environment.",
  },
];
---

<section class="section" id="panels" aria-labelledby="script-title">
  <div class="container">
    <p class="eyebrow">Panels</p>
    <h2 class="section-title" id="script-title">Anything you can script is a panel.</h2>
    <p class="section-lead">
      A panel is a folder with a <code>panel.jsonc</code> and a command. The command prints JSON, Tjuvkik draws it.
      Rows can carry actions, so the glance isn't only for looking.
    </p>

    <div class="split">
      <div class="files">
        <CodeBlock file="panels/prs/panel.jsonc" lang="jsonc" code={panelJson} />
        <CodeBlock file="panels/prs/prs.sh" lang="sh" code={script} />
      </div>

      <div class="wallpaper result">
        <div class="result-inner">
          <Tile panel={prActions} class="pr-tile" />
          <div class="menu" aria-label="The ⌘K list for the picked row">
            <div class="menu-title">feat: export filters</div>
            <div class="menu-item" data-on><span>Open PR</span><kbd>↵</kbd></div>
            <div class="menu-item"><span>Approve</span><kbd>⌘A</kbd></div>
            <div class="menu-item"><span>Check Out</span></div>
            <div class="menu-item"><span>Copy Link</span></div>
          </div>
          <div class="result-hints" aria-hidden="true">
            <span><kbd>↵</kbd> Open PR</span>
            <span><kbd>⌘A</kbd> Approve</span>
            <span><kbd>⌘K</kbd> Actions</span>
          </div>
        </div>
      </div>
    </div>

    <ul class="points">
      {
        points.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="smallest">
      <p>The smallest panel there is: your Downloads folder, newest first.</p>
      <CodeBlock lang="sh" code={oneLiner} />
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px;
    margin-top: 56px;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  .files {
    display: grid;
    gap: 14px;
    align-content: start;
    min-width: 0;
  }

  .result {
    display: grid;
    place-items: center;
    padding: clamp(24px, 4vw, 48px) clamp(16px, 3vw, 36px);
    min-height: 420px;
  }

  .result-inner {
    position: relative;
    width: min(100%, 470px);
    display: grid;
    gap: 14px;
  }

  .result :global(.pr-tile) {
    --u: 1.12px;
    height: 300px;
  }

  .menu {
    position: absolute;
    top: 118px;
    right: -14px;
    width: 220px;
    padding: 6px;
    border-radius: 12px;
    background: rgba(36, 36, 48, 0.82);
    -webkit-backdrop-filter: blur(30px) saturate(1.6);
    backdrop-filter: blur(30px) saturate(1.6);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.12) inset,
      0 20px 50px rgba(0, 0, 0, 0.5);
    font-size: 13px;
  }

  @media (max-width: 520px) {
    .menu {
      right: 0;
      top: 150px;
    }
    .result-hints {
      display: none;
    }
  }

  .menu-title {
    padding: 6px 10px 6px;
    font-size: 11px;
    color: var(--faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .menu-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 10px;
    border-radius: 7px;
  }

  .menu-item[data-on] {
    background: rgba(189, 147, 249, 0.28);
  }

  .menu kbd,
  .result-hints kbd {
    font: 500 11px/1 var(--mono);
    padding: 3px 5px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--muted);
  }

  .result-hints {
    display: flex;
    justify-content: center;
    gap: 16px;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.62);
  }

  .result-hints span {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }

  .points {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  @media (max-width: 980px) {
    .points {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .points {
      grid-template-columns: 1fr;
    }
  }

  .points h3 {
    margin: 0 0 6px;
    font-size: 16.5px;
    letter-spacing: -0.01em;
  }

  .points p {
    margin: 0;
    font-size: 15px;
    color: var(--text-muted);
  }

  .smallest {
    margin-top: 48px;
    display: grid;
    gap: 12px;
  }

  .smallest p {
    margin: 0;
    font-size: 15px;
    color: var(--text-faint);
  }
</style>
