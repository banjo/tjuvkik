---
import { site } from "../data/site";
import CodeBlock from "./CodeBlock.astro";

const config = `
{
  "$schema": "${site.schema("config")}",
  "theme": { "dark": "dark-glass", "light": "light-glass" },
  "trigger": { "key": "fn", "mode": "hold" },
  "menuBar": ["agents", "prs"],
  "panels": [
    { "panel": "agents", "size": "2x2" },
    { "panel": "prs", "size": "2x1" },
    { "panel": "ci", "id": "ci-web", "options": { "repo": "acme/web" } },
    { "panel": "ci", "id": "ci-api", "options": { "repo": "acme/api" } },
    { "panel": "pods", "size": "2x1" }
  ]
}`;

const tree = `
~/.config/tjuvkik/
├── config.jsonc        what goes where, theme, trigger
├── panels/
│   ├── agents/
│   │   ├── panel.jsonc
│   │   └── agents.jq
│   ├── ci/
│   │   ├── panel.jsonc
│   │   └── ci.sh
│   └── prs/
│       ├── panel.jsonc
│       └── prs.sh
└── themes/
    └── mine.jsonc      { "extends": "dracula" }`;

const points = [
  ["Keep it in your dotfiles", "Link the folder with stow or ln -s. Tjuvkik follows the links."],
  ["Reloads on save", "Change a file and the board updates within a second. A broken edit keeps the last good board and says what's wrong."],
  ["Checked in CI", "tjuvkik validate prints every error with its file and key, and exits 1."],
  ["Share a panel by copying a folder", "Fill in description, author and requires, and send it."],
];
---

<section class="section" id="config" aria-labelledby="config-title">
  <div class="container">
    <p class="eyebrow">Config as code</p>
    <h2 class="section-title" id="config-title">One folder. Plain files. Yours.</h2>
    <p class="section-lead">
      There's no account and no cloud. Everything lives in <code>~/.config/tjuvkik</code> as JSON with comments,
      with schemas for completion in your editor. The settings window edits the same files.
    </p>

    <div class="split">
      <CodeBlock file="config.jsonc" lang="jsonc" code={config} />
      <CodeBlock lang="text" code={tree} />
    </div>

    <ul class="points">
      {
        points.map(([t, d]) => (
          <li>
            <h3>{t}</h3>
            <p>{d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 20px;
    margin-top: 56px;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  .points {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
  }

  @media (max-width: 980px) {
    .points {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .points {
      grid-template-columns: 1fr;
    }
  }

  .points h3 {
    margin: 0 0 6px;
    font-size: 16.5px;
    letter-spacing: -0.01em;
  }

  .points p {
    margin: 0;
    font-size: 15px;
    color: var(--text-muted);
  }
</style>
