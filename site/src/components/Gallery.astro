---
import { gallery } from "../data/panels";
import Tile from "./Tile.astro";
---

<section class="section gallery" aria-labelledby="types-title">
  <div class="container">
    <p class="eyebrow">Panel types</p>
    <h2 class="section-title" id="types-title">Twelve ways to draw your output.</h2>
    <p class="section-lead">
      Rows by default. Name a type at the top of your JSON and the same script gets a chart, a table, a timeline or
      a feed, each drawn for the size of its tile.
    </p>
  </div>

  <div class="container wide">
    <ul class="wallpaper board">
      {
        gallery.map((g) => (
          <li>
            <Tile panel={g.panel} class="g-tile" headingLevel="h3" />
            <p class="caption">
              <code>{g.type}</code> {g.blurb}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .wide {
    width: min(1280px, 100% - 32px);
  }

  .board {
    list-style: none;
    margin: 56px 0 0;
    padding: clamp(14px, 2.4vw, 32px);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 22px);
  }

  @media (max-width: 980px) {
    .board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .board {
      grid-template-columns: 1fr;
    }
  }

  .board li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .board :global(.g-tile) {
    height: 268px;
  }

  .board :global(.g-tile h3) {
    margin: 0;
  }

  .caption {
    margin: 0;
    padding: 0 4px;
    font-size: 13.5px;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.72);
  }

  .caption code {
    margin-right: 4px;
    padding: 2px 6px;
    border-radius: 5px;
    background: rgba(0, 0, 0, 0.3);
    font-size: 12px;
    color: #fff;
  }
</style>
