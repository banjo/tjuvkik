<div class="search" data-search>
  <label class="visually-hidden" for="docs-search">Search the docs</label>
  <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"
    ><circle cx="8.5" cy="8.5" r="5.5"></circle><path d="m13 13 4 4" stroke-linecap="round"></path></svg
  >
  <input
    id="docs-search"
    type="search"
    placeholder="Search"
    autocomplete="off"
    spellcheck="false"
    role="combobox"
    aria-expanded="false"
    aria-controls="docs-search-results"
    aria-autocomplete="list"
  />
  <kbd class="shortcut" aria-hidden="true">/</kbd>
  <div class="results" id="docs-search-results" role="listbox" hidden></div>
</div>

<style>
  .search {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 10px 0 12px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 0 0 1px var(--border) inset;
    color: var(--text-faint);
    transition: box-shadow 150ms ease-out;
  }

  .search:focus-within {
    box-shadow: 0 0 0 1px rgba(189, 147, 249, 0.6) inset;
  }

  input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    background: none;
    color: var(--text);
    font: 14px var(--sans);
    outline: none;
  }

  input::-webkit-search-cancel-button {
    display: none;
  }

  .shortcut {
    font: 500 11px/1 var(--mono);
    padding: 3px 6px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-faint);
  }

  .search:focus-within .shortcut {
    display: none;
  }

  .results {
    position: absolute;
    z-index: 20;
    top: calc(100% + 6px);
    left: 0;
    width: min(420px, calc(100vw - 32px));
    max-height: min(480px, 70vh);
    overflow: auto;
    padding: 6px;
    border-radius: 12px;
    background: rgba(30, 26, 48, 0.96);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.1) inset,
      0 20px 50px rgba(0, 0, 0, 0.5);
  }

  .results :global(a) {
    display: block;
    padding: 9px 11px;
    border-radius: 8px;
    text-decoration: none;
  }

  .results :global(a[aria-selected="true"]) {
    background: rgba(189, 147, 249, 0.18);
  }

  .results :global(.r-title) {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }

  .results :global(.r-title span) {
    font-weight: 400;
    color: var(--text-faint);
  }

  .results :global(.r-excerpt) {
    margin-top: 2px;
    font-size: 13px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .results :global(mark) {
    background: none;
    color: var(--accent);
    font-weight: 600;
  }

  .results :global(.r-empty) {
    padding: 10px 11px;
    font-size: 13.5px;
    color: var(--text-faint);
  }
</style>

<script>
  interface Result {
    url: string;
    meta: { title?: string };
    excerpt: string;
    sub_results?: { title: string; url: string; excerpt: string }[];
  }
  interface Pagefind {
    options(o: object): Promise<void>;
    debouncedSearch(q: string): Promise<{ results: { data(): Promise<Result> }[] } | null>;
  }

  const root = document.querySelector<HTMLElement>("[data-search]");
  const input = root?.querySelector("input");
  const list = root?.querySelector<HTMLElement>(".results");

  if (root && input && list) {
    let pagefind: Promise<Pagefind> | undefined;
    let selected = 0;

    const load = () => {
      const url = "/pagefind/pagefind.js";
      pagefind ??= import(/* @vite-ignore */ url).then(async (p: Pagefind) => {
        await p.options({ excerptLength: 16 });
        return p;
      });
      return pagefind;
    };

    const items = () => [...list.querySelectorAll<HTMLAnchorElement>("a")];
    const select = (i: number) => {
      const all = items();
      if (!all.length) return;
      selected = (i + all.length) % all.length;
      all.forEach((a, n) => a.setAttribute("aria-selected", String(n === selected)));
      all[selected].scrollIntoView({ block: "nearest" });
    };
    const show = (open: boolean) => {
      list.hidden = !open;
      input.setAttribute("aria-expanded", String(open));
    };
    const escape = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

    input.addEventListener("focus", () => void load().catch(() => {}));

    input.addEventListener("input", async () => {
      const q = input.value.trim();
      if (!q) return show(false);
      let found;
      try {
        found = await (await load()).debouncedSearch(q);
      } catch {
        list.innerHTML = `<div class="r-empty">Search works in the built site: pnpm build && pnpm preview.</div>`;
        return show(true);
      }
      if (!found || input.value.trim() !== q) return;
      const data = await Promise.all(found.results.slice(0, 8).map((r) => r.data()));
      list.innerHTML = data.length
        ? data
            .map((d) => {
              const sub = d.sub_results?.find((s) => s.url.includes("#"));
              const title = escape(d.meta.title ?? d.url);
              return `<a href="${escape(sub?.url ?? d.url)}" role="option">
                <div class="r-title">${title}${sub ? ` <span>› ${escape(sub.title)}</span>` : ""}</div>
                <div class="r-excerpt">${sub?.excerpt ?? d.excerpt}</div>
              </a>`;
            })
            .join("")
        : `<div class="r-empty">Nothing found for “${escape(q)}”.</div>`;
      show(true);
      select(0);
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        e.preventDefault();
        select(selected + (e.key === "ArrowDown" ? 1 : -1));
      } else if (e.key === "Enter") {
        const a = items()[selected];
        if (a) {
          e.preventDefault();
          location.href = a.href;
        }
      } else if (e.key === "Escape") {
        input.value = "";
        show(false);
        input.blur();
      }
    });

    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) show(false);
    });

    document.addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
      if (e.key === "/" || (e.key === "k" && (e.metaKey || e.ctrlKey))) {
        e.preventDefault();
        root.closest("details")?.setAttribute("open", "");
        input.focus();
      }
    });
  }
</script>
