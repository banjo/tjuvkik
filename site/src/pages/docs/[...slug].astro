---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import DocsSearch from "../../components/DocsSearch.astro";
import Footer from "../../components/Footer.astro";
import Nav from "../../components/Nav.astro";
import { site } from "../../data/site";
import Base from "../../layouts/Base.astro";
import { docMarkdownPath, docPath } from "../../lib/doc-links";
import { docGroups, type DocPage } from "../../lib/docs";

export const getStaticPaths = (async () => {
  const groups = await docGroups();
  const pages = groups.flatMap((g) => g.pages);
  return pages.map((page, i) => ({
    params: { slug: page.id === "README" ? undefined : page.id },
    props: { page, groups, prev: pages[i - 1], next: pages[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  page: DocPage;
  groups: Awaited<ReturnType<typeof docGroups>>;
  prev?: DocPage;
  next?: DocPage;
}

const { page, groups, prev, next } = Astro.props;
const { Content, headings } = await render(page.doc);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const group = groups.find((g) => g.pages.includes(page));
const url = new URL(docPath(page.id), site.url).href;
const markdownUrl = docMarkdownPath(page.id);

const structured = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "TechArticle",
      headline: page.title,
      description: page.description,
      url,
      inLanguage: "en",
      author: { "@type": "Person", name: "Anton Ödman", url: "https://banjoanton.com" },
      about: { "@type": "SoftwareApplication", name: "Tjuvkik", url: site.url },
      encoding: { "@type": "MediaObject", encodingFormat: "text/markdown", contentUrl: site.url + markdownUrl },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Tjuvkik", item: `${site.url}/` },
        { "@type": "ListItem", position: 2, name: "Docs", item: `${site.url}/docs/` },
        ...(page.id === "README" ? [] : [{ "@type": "ListItem", position: 3, name: page.label, item: url }]),
      ],
    },
  ],
};
---

<Base
  title={page.id === "README" ? "Tjuvkik docs" : `${page.title} · Tjuvkik docs`}
  description={page.description}
  structured={structured}
>
  <link slot="head" rel="alternate" type="text/markdown" href={markdownUrl} title="This page as Markdown" />

  <Nav current="docs" />

  <div class="docs">
    <details class="sidebar" open data-sidebar>
      <summary>
        <span>{page.label}</span>
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"
          ><path d="m4 6 4 4 4-4" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
      </summary>
      <div class="sidebar-inner">
        <DocsSearch />
        <nav aria-label="Docs">
          {
            groups.map((g) => (
              <div class="group">
                <p class="group-title">{g.title}</p>
                <ul>
                  {g.pages.map((p) => (
                    <li>
                      <a href={docPath(p.id)} aria-current={p.id === page.id ? "page" : undefined}>
                        {p.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </div>
    </details>

    <main class="main">
      <article data-pagefind-body>
        <header class="head">
          <p class="eyebrow" data-pagefind-ignore>{group?.title}</p>
          <h1 data-pagefind-meta="title">{page.title}</h1>
          <div class="actions" data-pagefind-ignore>
            <button type="button" class="action" data-copy-page={markdownUrl}>
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5"
                ><rect x="5" y="5" width="9" height="9" rx="2"></rect><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"
                ></path></svg
              >
              <span>Copy as Markdown</span>
            </button>
            <a class="action" href={markdownUrl}>View as Markdown</a>
            <a class="action" href={`${site.repo}/edit/main/docs/${page.id}.md`}>Edit on GitHub</a>
          </div>
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>

      <nav class="pager" aria-label="Previous and next page">
        {
          prev ? (
            <a href={docPath(prev.id)} rel="prev">
              <span>Previous</span>
              {prev.label}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={docPath(next.id)} rel="next" class="next">
              <span>Next</span>
              {next.label}
            </a>
          )
        }
      </nav>
    </main>

    <aside class="toc" aria-label="On this page">
      {
        toc.length > 1 && (
          <>
            <p class="group-title">On this page</p>
            <ul>
              {toc.map((h) => (
                <li data-depth={h.depth}>
                  <a href={`#${h.slug}`}>{h.text.replace(/#$/, "")}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </aside>
  </div>

  <Footer />
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr) 208px;
    gap: clamp(24px, 4vw, 56px);
    max-width: 1360px;
    margin: 0 auto;
    padding: 8px clamp(16px, 3vw, 32px) 64px;
  }

  @media (max-width: 1180px) {
    .docs {
      grid-template-columns: 228px minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
  }

  /* Sidebar */
  .sidebar {
    position: sticky;
    z-index: 5;
    top: 16px;
    align-self: start;
  }

  /* Only the links scroll, so search results can hang out over the page. */
  .sidebar-inner {
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 32px);
  }

  .sidebar nav {
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    padding-bottom: 16px;
  }

  .sidebar summary {
    display: none;
  }

  @media (max-width: 820px) {
    .sidebar {
      position: relative;
      top: 0;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.04);
      box-shadow: 0 0 0 1px var(--border) inset;
    }
    .sidebar summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }
    .sidebar summary::-webkit-details-marker {
      display: none;
    }
    .sidebar summary svg {
      transition: transform 200ms var(--ease-out);
    }
    .sidebar[open] summary svg {
      transform: rotate(180deg);
    }
    .sidebar-inner {
      max-height: none;
      padding: 0 12px 12px;
    }
  }

  .group {
    margin-top: 26px;
  }

  .group-title {
    margin: 0 0 8px;
    padding-left: 12px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .sidebar ul,
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar nav a {
    display: block;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 14.5px;
    color: var(--text-muted);
    text-decoration: none;
    transition:
      background-color 150ms ease-out,
      color 150ms ease-out;
  }

  .sidebar nav a[aria-current="page"] {
    background: rgba(189, 147, 249, 0.14);
    color: var(--text);
    font-weight: 550;
  }

  @media (hover: hover) {
    .sidebar nav a:hover {
      color: var(--text);
    }
  }

  /* Article */
  .main {
    min-width: 0;
    max-width: 780px;
  }

  .head {
    padding: 22px 0 28px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .head h1 {
    margin: 0;
    font-size: clamp(34px, 4.4vw, 46px);
    line-height: 1.08;
    font-weight: 680;
    letter-spacing: -0.035em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 12px;
    border: 0;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 0 0 1px var(--border) inset;
    color: var(--text-muted);
    font: 500 13px var(--sans);
    text-decoration: none;
    cursor: pointer;
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out,
      transform 120ms var(--ease-out);
  }

  .action:active {
    transform: scale(0.97);
  }

  @media (hover: hover) {
    .action:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.1);
    }
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 56px;
  }

  .pager a {
    display: grid;
    gap: 2px;
    padding: 16px 18px;
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--border) inset;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: box-shadow 150ms ease-out;
  }

  .pager .next {
    text-align: right;
  }

  .pager span {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--text-faint);
  }

  @media (hover: hover) {
    .pager a:hover {
      box-shadow: 0 0 0 1px rgba(189, 147, 249, 0.5) inset;
    }
  }

  /* On this page */
  .toc {
    position: sticky;
    top: 16px;
    align-self: start;
    max-height: calc(100vh - 32px);
    overflow: auto;
    padding-top: 26px;
  }

  .toc .group-title {
    padding-left: 0;
  }

  .toc a {
    display: block;
    padding: 4px 0 4px 12px;
    border-left: 1px solid var(--border);
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--text-faint);
    text-decoration: none;
    transition:
      color 150ms ease-out,
      border-color 150ms ease-out;
  }

  .toc li[data-depth="3"] a {
    padding-left: 24px;
  }

  .toc a[data-active] {
    color: var(--text);
    border-left-color: var(--accent);
  }

  @media (hover: hover) {
    .toc a:hover {
      color: var(--text);
    }
  }

  /* The Markdown */
  .prose {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(248, 248, 242, 0.82);
  }

  .prose :global(h2) {
    margin: 52px 0 12px;
    font-size: 25px;
    line-height: 1.25;
    font-weight: 650;
    letter-spacing: -0.02em;
    color: var(--text);
    scroll-margin-top: 24px;
  }

  .prose :global(h3) {
    margin: 36px 0 8px;
    font-size: 19px;
    font-weight: 620;
    letter-spacing: -0.01em;
    color: var(--text);
    scroll-margin-top: 24px;
  }

  .prose :global(h4) {
    margin: 28px 0 6px;
    font-size: 16px;
    color: var(--text);
  }

  .prose :global(.anchor) {
    margin-left: 8px;
    color: var(--text-faint);
    text-decoration: none;
    opacity: 0;
    transition: opacity 150ms ease-out;
  }

  .prose :global(h2:hover .anchor),
  .prose :global(h3:hover .anchor),
  .prose :global(.anchor:focus-visible) {
    opacity: 1;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 14px 0;
  }

  .prose :global(li) {
    margin: 5px 0;
  }

  .prose :global(li::marker) {
    color: var(--text-faint);
  }

  .prose :global(a) {
    color: var(--accent);
    text-decoration-color: rgba(189, 147, 249, 0.4);
    text-underline-offset: 3px;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(:not(pre) > code) {
    font-size: 0.86em;
    padding: 0.14em 0.42em;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .prose :global(pre) {
    margin: 18px 0;
    padding: 16px 18px;
    border-radius: 14px;
    background: #1f2029 !important;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    font-size: 13.5px;
    line-height: 1.65;
    overflow-x: auto;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
    font-size: inherit;
  }

  .prose :global(blockquote) {
    margin: 18px 0;
    padding: 4px 18px;
    border-left: 2px solid var(--accent);
    background: rgba(189, 147, 249, 0.06);
    border-radius: 0 10px 10px 0;
  }

  .prose :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    margin: 18px 0;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 14.5px;
    line-height: 1.5;
  }

  .prose :global(th) {
    padding: 8px 14px 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }

  .prose :global(td) {
    padding: 8px 14px 8px 0;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .prose :global(hr) {
    margin: 40px 0;
    border: 0;
    border-top: 1px solid var(--border);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }

  /* Tile previews: s and m side by side, l under them. The PNGs have 24pt of shadow on every side. */
  .prose :global(.shots) {
    display: grid;
    grid-template-columns: 305fr 573fr;
    align-items: start;
    margin: 18px -24px 6px;
  }

  .prose :global(.shots img:nth-child(3)) {
    grid-column: 1 / -1;
    width: min(573px, 100%);
    margin-top: -24px;
  }

  @media (max-width: 640px) {
    .prose :global(.shots) {
      grid-template-columns: 1fr;
      margin-inline: -16px;
    }
    .prose :global(.shots img) {
      width: 100%;
      margin-top: -24px;
    }
    .prose :global(.shots img:first-child) {
      width: calc(100% * 305 / 573);
      margin-top: 0;
    }
  }
</style>

<script>
  // Close the menu on phones; it's open by default so the docs work without JavaScript.
  const sidebar = document.querySelector<HTMLDetailsElement>("[data-sidebar]");
  if (sidebar && matchMedia("(max-width: 820px)").matches) sidebar.open = false;

  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-page]")) {
    const label = button.querySelector("span");
    button.addEventListener("click", async () => {
      const text = await (await fetch(button.dataset.copyPage ?? "")).text();
      await navigator.clipboard.writeText(text);
      if (label) {
        label.textContent = "Copied";
        setTimeout(() => (label.textContent = "Copy as Markdown"), 1600);
      }
    });
  }

  // Mark the section being read in "On this page".
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>(".toc a")].map((a) => [a.hash.slice(1), a] as const),
  );
  const headings = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((h): h is HTMLElement => !!h);
  if (headings.length) {
    const mark = () => {
      const current = headings.filter((h) => h.getBoundingClientRect().top < 120).pop() ?? headings[0];
      for (const [id, a] of links) a.toggleAttribute("data-active", id === current.id);
    };
    addEventListener("scroll", mark, { passive: true });
    mark();
  }
</script>
