---
// The Open Graph image, 1200×630. Capture it to public/og.png (see PLAN.md); not linked or indexed.
import "../styles/global.css";
import Tile from "../components/Tile.astro";
import { heroBoard } from "../data/panels";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Tjuvkik OG image</title>
  </head>
  <body>
    <div class="og">
      <div class="copy">
        <div class="brand"><img src="/icon.svg" alt="" width="64" height="64" />Tjuvkik</div>
        <h1>Hold fn.<br />See everything.</h1>
        <p>A glanceable, scriptable dashboard for macOS.</p>
      </div>
      <div class="board">
        {heroBoard.map(({ panel, area }) => <Tile panel={panel} style={`grid-area: ${area}`} />)}
      </div>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: #000;
  }

  .og {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: var(--wallpaper);
  }

  .og::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(14, 11, 26, 0.85) 30%, rgba(14, 11, 26, 0.2));
  }

  .copy {
    position: absolute;
    left: 64px;
    top: 0;
    bottom: 0;
    width: 500px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 1;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-left: -10px;
    font-size: 26px;
    font-weight: 650;
  }

  h1 {
    margin: 28px 0 0;
    font-size: 68px;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  p {
    margin: 22px 0 0;
    font-size: 24px;
    color: var(--text-muted);
  }

  .board {
    --u: 0.86px;
    position: absolute;
    left: 560px;
    top: 74px;
    width: 930px;
    height: 482px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 9px;
  }
</style>
