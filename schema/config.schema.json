{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tjuvkik config.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "view": {
      "enum": [
        "bento",
        "spotlight"
      ],
      "default": "bento",
      "description": "What holding fn shows. \"spotlight\" comes later."
    },
    "layout": {
      "enum": [
        "framed",
        "fullscreen",
        "edges"
      ],
      "default": "framed",
      "description": "How the board sits on screen. Only \"framed\" for now."
    },
    "theme": {
      "type": "string",
      "default": "dark-glass",
      "description": "\"dark-glass\", \"light-glass\", \"dracula\", or a file in themes/ without \".json\".",
      "examples": [
        "dark-glass",
        "light-glass",
        "dracula"
      ]
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "holdMs": {
          "type": "integer",
          "minimum": 50,
          "maximum": 2000,
          "default": 250,
          "description": "How long to hold fn before the glance shows."
        }
      }
    },
    "launchAtLogin": {
      "type": "boolean",
      "default": true,
      "description": "Start Tjuvkik when you log in."
    },
    "menuBar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "Panels in panels shown in the menu bar, in order. Each panel decides what it shows there; by default its first summary count.",
      "examples": [
        "agents",
        [
          "agents",
          "github"
        ]
      ]
    },
    "panels": {
      "type": "array",
      "description": "Panels fill a 4×3 grid in order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "panel"
        ],
        "properties": {
          "panel": {
            "type": "string",
            "description": "A folder in panels/."
          },
          "size": {
            "enum": [
              "s",
              "m",
              "l",
              "xl"
            ],
            "description": "Size here; overrides the panel's own. s 1×1, m 2×1, l 2×2, xl 2×3"
          }
        }
      }
    }
  }
}
